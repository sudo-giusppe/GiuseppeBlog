---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = "Notas de matemática, sistemas computacionales y código, por Giuseppe Barraza.",
} = Astro.props;

const fullTitle =
	title === "Inicio"
		? "Giuseppe Barraza — notas de matemática y sistemas"
		: `${title} · Giuseppe Barraza`;
---

<!doctype html>
<html lang="es" class="no-js">
	<head>
		<meta charset="UTF-8" />
		<script is:inline>
			(() => {
				const root = document.documentElement;
				root.classList.remove("no-js");
				root.classList.add("js");
				let saved = null;
				try {
					saved = localStorage.getItem("theme");
				} catch {
					/* almacenamiento no disponible */
				}
				const dark = saved
					? saved === "dark"
					: window.matchMedia("(prefers-color-scheme: dark)").matches;
				root.dataset.theme = dark ? "dark" : "light";
			})();
		</script>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_CL" />
		<meta name="twitter:card" content="summary" />
		<meta
			name="theme-color"
			content="#f5f2ea"
			media="(prefers-color-scheme: light)"
		/>
		<meta
			name="theme-color"
			content="#121310"
			media="(prefers-color-scheme: dark)"
		/>
		<link
			rel="preload"
			href="/fonts/source-serif-4-latin-normal.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/ibm-plex-mono-400.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{fullTitle}</title>
	</head>
	<body>
		<a class="skip-link" href="#main">Saltar al contenido</a>
		<div class="progress" aria-hidden="true">
			<span class="progress__bar"></span>
		</div>
		<Header />
		<main id="main" class="site-main">
			<div class="wrap">
				<slot />
			</div>
		</main>
		<Footer />

		<script>
			import { animate, scroll, stagger } from "motion";

			const reduce = window.matchMedia(
				"(prefers-reduced-motion: reduce)",
			).matches;

			const bar = document.querySelector<HTMLElement>(".progress__bar");
			if (bar) {
				scroll(animate(bar, { scaleX: [0, 1] }, { ease: "linear" }));
			}

			const reveal = [...document.querySelectorAll<HTMLElement>("[data-reveal]")];
			if (!reduce && reveal.length > 0) {
				animate(
					reveal,
					{ opacity: [0.72, 1], y: [8, 0] },
					{
						duration: 0.6,
						delay: stagger(0.06),
						ease: [0.22, 1, 0.36, 1],
					},
				);
			}
		</script>
	</body>
</html>

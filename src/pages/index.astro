---
import Layout from "../layouts/Layout.astro";
import AntField from "../components/AntField.astro";
import Plot from "../components/Plot.astro";
import MagneticLink from "../components/MagneticLink.astro";
import { posts } from "../data/posts";

const latest = posts.slice(0, 3);
---

<Layout title="Inicio">
	<section class="intro" data-reveal>
		<p class="kicker">reciente</p>
		<h1 class="intro-title">Notas recientes</h1>
		<p class="lede">
			Matemática, sistemas computacionales y código. Escribo para ordenar lo
			que aprendo y dejar registro de lo que no quiero volver a deducir.
		</p>
	</section>

	<div data-reveal>
		<Plot />
	</div>

	<div class="section-head" data-reveal>
		<h2>últimas entradas</h2>
	</div>

	<ol class="entries">
		{
			latest.map((post) => (
				<li data-reveal>
					<article class="entry">
						<a class="entry-link" href={post.href}>
							<div class="entry-meta">
								<time datetime={post.date}>{post.date}</time>
								<span class="sep" aria-hidden="true">·</span>
								<span>{post.category}</span>
								<span class="sep" aria-hidden="true">·</span>
								<span>{post.minutes} min</span>
							</div>
							<h2 class="entry-title">
								<span>{post.title}</span>
								<span class="entry-arrow" aria-hidden="true">→</span>
							</h2>
							<p class="entry-desc">{post.description}</p>
						</a>
					</article>
				</li>
			))
		}
	</ol>

	<div class="home-more" data-reveal>
		<MagneticLink href="/blog">
			Archivo completo <span class="arrow" aria-hidden="true">→</span>
		</MagneticLink>
		<a class="arrow-link" href="/about">
			Acerca de mí <span class="arrow" aria-hidden="true">→</span>
		</a>
		<a class="arrow-link" href="/forum">
			Discusión <span class="arrow" aria-hidden="true">→</span>
		</a>
	</div>

	<p class="now-line" data-reveal>
		<span class="now-label">ahora</span>
		<span>
			Simulando la <a href="/blog/langtons-ant">hormiga de Langton</a> y
			ajustando un algoritmo genético.
		</span>
	</p>

	<AntField variant="classic" />
</Layout>

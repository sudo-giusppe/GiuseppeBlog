---
import Layout from "../layouts/Layout.astro";
import AntField from "../components/AntField.astro";
---

<Layout
	title="Acerca"
	description="José Pedro Barraza — LICC, PUC de Chile, embajador IBM Z."
>
	<section class="about-page">
		<header class="about-hero" data-reveal>
			<p class="kicker">acerca</p>
			<h1 class="about-name">José Pedro<br />Barraza</h1>
			<p class="about-intro">
				Estudio en la LICC de la PUC de Chile.<br />
				Soy embajador IBM Z.
			</p>
		</header>

		<footer class="about-foot" data-reveal>
			<p class="about-place">Santiago, Chile</p>
			<nav class="about-links" aria-label="Enlaces personales">
				<a href="/blog">notas <span aria-hidden="true">→</span></a>
				<a href="/forum">discusión <span aria-hidden="true">→</span></a>
			</nav>
		</footer>

		<AntField variant="turmite" />
	</section>
</Layout>

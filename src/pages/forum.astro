---
import Layout from "../layouts/Layout.astro";
import AntField from "../components/AntField.astro";
---

<Layout
	title="Discusión"
	description="Sala de discusión sobre autómatas, algoritmos evolutivos y sistemas que producen comportamiento complejo."
>
	<header class="page-head" data-reveal>
		<p class="kicker">discusión</p>
		<h1 class="page-title">Sala abierta</h1>
		<p class="lede">
			Preguntas sobre autómatas, algoritmos evolutivos y sistemas que producen
			comportamiento complejo. No hace falta saber la respuesta para preguntar.
		</p>
	</header>

	<section class="room" data-reveal aria-labelledby="room-title">
		<div class="room-head">
			<span id="room-title">sala / autómatas y algoritmos</span>
			<span class="room-live">abierta</span>
		</div>

		<div
			class="messages"
			id="chat-messages"
			aria-live="polite"
			aria-label="Mensajes de la sala"
		>
			<div class="message">
				<span class="message-user">alice</span>
				<p class="message-text">
					¿Por qué la hormiga de Langton construye una autopista después de
					tantos pasos?
				</p>
			</div>
			<div class="message">
				<span class="message-user">bob</span>
				<p class="message-text">
					Nadie programa la autopista: sale de las dos reglas. Es el ejemplo
					más limpio de emergencia que conozco.
				</p>
			</div>
			<div class="message">
				<span class="message-user">charlie</span>
				<p class="message-text">
					En un algoritmo genético pasa algo parecido: no hay una solución
					escrita, solo selección y variación.
				</p>
			</div>
		</div>

		<form class="composer" id="chat-form">
			<span class="composer-prompt" aria-hidden="true">&gt;</span>
			<label class="visually-hidden" for="message-input">Mensaje</label>
			<input
				id="message-input"
				name="message"
				type="text"
				autocomplete="off"
				placeholder="Escribe un mensaje…"
			/>
			<button type="submit">enviar</button>
		</form>
	</section>

	<p class="room-note">
		Sala de demostración. Los mensajes viven en memoria y se borran al
		recargar la página. No publiques datos personales.
	</p>

	<AntField variant="colony" />
</Layout>

<script>
	import { animate } from "motion";

	const form = document.getElementById("chat-form") as HTMLFormElement | null;
	const input = document.getElementById(
		"message-input",
	) as HTMLInputElement | null;
	const messages = document.getElementById("chat-messages");
	const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	const addMessage = (text: string) => {
		if (!messages) return;

		const row = document.createElement("div");
		row.className = "message";

		const user = document.createElement("span");
		user.className = "message-user";
		user.textContent = "tú";

		const body = document.createElement("p");
		body.className = "message-text";
		body.textContent = text;

		row.append(user, body);
		messages.append(row);
		messages.scrollTop = messages.scrollHeight;

		if (!reduce) {
			animate(
				row,
				{ opacity: [0, 1], y: [7, 0] },
				{ duration: 0.35, ease: [0.22, 1, 0.36, 1] },
			);
		}
	};

	form?.addEventListener("submit", (event) => {
		event.preventDefault();
		const text = input?.value.trim();
		if (!text) return;
		addMessage(text);
		if (input) {
			input.value = "";
			input.focus();
		}
	});
</script>

---
import Layout from "../layouts/Layout.astro";
import AntField from "../components/AntField.astro";
import SmoothTabs from "../components/SmoothTabs.astro";
import { categories, countFor, posts } from "../data/posts";

const tabs = categories.map((category) => ({
	...category,
	count: countFor(category.value),
}));
---

<Layout
	title="Archivo"
	description="Archivo de notas sobre matemática, sistemas computacionales y código."
>
	<header class="page-head" data-reveal>
		<p class="kicker">archivo</p>
		<h1 class="page-title">Archivo</h1>
		<p class="lede">
			Todas las notas, en orden inverso. La lista se puede filtrar por tema.
		</p>
	</header>

	<div data-reveal>
		<SmoothTabs items={tabs} total={posts.length} />
	</div>

	<ul class="archive" id="archive-list">
		{
			posts.map((post) => (
				<li data-post data-category={post.category}>
					<a class="archive-row" href={post.href}>
						<time class="archive-date" datetime={post.date}>
							{post.date}
						</time>
						<span class="archive-title">{post.title}</span>
						<span class="archive-cat">{post.category}</span>
						<span class="archive-arrow" aria-hidden="true">
							→
						</span>
					</a>
				</li>
			))
		}
	</ul>

	<p class="forum-note">
		¿Dudas sobre autómatas o algoritmos evolutivos? La sala de
		<a href="/forum">discusión</a> sigue abierta.
	</p>

	<AntField variant="mirror" />
</Layout>

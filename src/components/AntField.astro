---
import { fieldConfigs, type FieldVariant } from "../data/fields";

interface Props {
	variant?: FieldVariant;
	intensity?: "normal" | "quiet";
}

const { variant = "classic", intensity = "normal" } = Astro.props;
const config = fieldConfigs[variant];
---

<div
	class="ant-field"
	data-ant-field
	data-variant={variant}
	data-intensity={intensity}
	aria-hidden="true"
>
	<canvas data-ant-canvas></canvas>
	<span class="ant-cursor" data-ant-cursor></span>
</div>

<div class="ant-readout">
	<span class="ant-readout-label">
		<span class="ant-pulse" aria-hidden="true"></span>
		<span data-ant-label>{config.label}</span>
		<span class="ant-sep" aria-hidden="true">·</span>
		<span data-ant-steps>000.000</span>
		<span class="ant-unit">pasos</span>
	</span>
	<button
		class="ant-toggle"
		type="button"
		data-ant-toggle
		aria-label="Pausar la animación de fondo"
	>pausar</button
	>
</div>

<script>
	import { fieldConfigs, type FieldVariant } from "../data/fields";

	const root = document.querySelector<HTMLElement>("[data-ant-field]");
	const canvas = root?.querySelector<HTMLCanvasElement>("[data-ant-canvas]");
	const firstCursor = root?.querySelector<HTMLElement>("[data-ant-cursor]");
	const stepsEl = document.querySelector<HTMLElement>("[data-ant-steps]");
	const toggle = document.querySelector<HTMLButtonElement>("[data-ant-toggle]");

	if (root && canvas && firstCursor && stepsEl && toggle) {
		const ctx = canvas.getContext("2d");

		if (ctx) {
			const variant = (root.dataset.variant as FieldVariant) || "classic";
			const config = fieldConfigs[variant] ?? fieldConfigs.classic;
			const intensity =
				root.dataset.intensity === "quiet" ? "quiet" : "normal";
			const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
			const DX = [0, 1, 0, -1];
			const DY = [-1, 0, 1, 0];
			const CYCLE = 120000;
			const SPEED = 360;

			let cell = 10;
			let cols = 0;
			let rows = 0;
			let grid = new Uint8Array(0);
			let ants: { x: number; y: number; dir: number; rule: string }[] = [];
			let cursorEls: HTMLElement[] = [firstCursor];
			let steps = 0;
			let shown = -1;
			let raf = 0;
			let last = 0;
			let carry = 0;
			let running = false;
			let userPaused = false;
			let resetting = false;
			let ink = "#1b1c19";
			let accent = "#215c45";
			let alpha = 0.06;
			let resizeTimer = 0;

			const readTheme = () => {
				const styles = getComputedStyle(document.documentElement);
				ink = styles.getPropertyValue("--ink").trim() || "#1b1c19";
				accent = styles.getPropertyValue("--accent").trim() || "#215c45";

				const base = intensity === "quiet" ? 0.035 : 0.06;
				const mobile = window.innerWidth < 700 ? 0.75 : 1;
				const dark = document.documentElement.dataset.theme === "dark" ? 0.9 : 1;
				alpha = base * config.weight * mobile * dark;
			};

			const setCursorOpacity = (value: string) => {
				cursorEls.forEach((cursor) => {
					cursor.style.opacity = value;
				});
			};

			const ensureCursors = (count: number) => {
				while (cursorEls.length < count) {
					const cursor = document.createElement("span");
					cursor.className = "ant-cursor";
					cursor.setAttribute("aria-hidden", "true");
					root.appendChild(cursor);
					cursorEls.push(cursor);
				}
				while (cursorEls.length > count) {
					cursorEls.pop()?.remove();
				}
			};

			const paintCell = (x: number, y: number, state: number) => {
				const px = x * cell;
				const py = y * cell;

				if (state === 0) {
					ctx.clearRect(px, py, cell, cell);
					return;
				}

				ctx.fillStyle = state === 1 ? ink : accent;
				ctx.globalAlpha =
					state === 1 ? alpha : Math.min(alpha * 1.5, 0.16);
				ctx.fillRect(px, py, cell - 1, cell - 1);
			};

			const advance = (paint: boolean) => {
				for (const ant of ants) {
					const index = ant.y * cols + ant.x;
					const state = grid[index];
					const turn = ant.rule[state] ?? "R";
					ant.dir = (ant.dir + (turn === "R" ? 1 : 3)) & 3;
					const next = (state + 1) % config.colors;
					grid[index] = next;
					if (paint) paintCell(ant.x, ant.y, next);
					ant.x = (ant.x + DX[ant.dir] + cols) % cols;
					ant.y = (ant.y + DY[ant.dir] + rows) % rows;
				}
				steps += ants.length;
			};

			const paintAll = () => {
				ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
				for (let y = 0; y < rows; y++) {
					for (let x = 0; x < cols; x++) {
						const state = grid[y * cols + x];
						if (state === 0) continue;
						ctx.fillStyle = state === 1 ? ink : accent;
						ctx.globalAlpha =
							state === 1 ? alpha : Math.min(alpha * 1.5, 0.16);
						ctx.fillRect(x * cell, y * cell, cell - 1, cell - 1);
					}
				}
				ctx.globalAlpha = 1;
			};

			const updateReadout = () => {
				ants.forEach((ant, index) => {
					const cursor = cursorEls[index];
					if (!cursor) return;
					cursor.style.transform = `translate3d(${
						ant.x * cell + cell / 2 - 2
					}px, ${ant.y * cell + cell / 2 - 2}px, 0)`;
				});

				if (steps === shown) return;
				shown = steps;
				stepsEl.textContent = steps.toLocaleString("es-CL");
			};

			const setToggle = () => {
				toggle.textContent = running ? "pausar" : "seguir";
				toggle.setAttribute(
					"aria-label",
					running
						? "Pausar la animación de fondo"
						: "Reanudar la animación de fondo",
				);
			};

			const makeAnts = () => {
				const width = window.innerWidth;
				const baseY = () => Math.floor(rows * (0.28 + Math.random() * 0.4));

				if (config.layout === "colony") {
					const xs = [0.2, 0.5, 0.8];
					return config.rules.map((rule, index) => ({
						rule,
						x: Math.floor(cols * xs[index]),
						y: Math.floor(
							rows * (0.3 + index * 0.18 + Math.random() * 0.08),
						),
						dir: (index + 1) % 4,
					}));
				}

				if (config.layout === "duet") {
					const xs = [0.32, 0.68];
					return config.rules.map((rule, index) => ({
						rule,
						x: Math.floor(cols * xs[index]),
						y: Math.floor(
							rows * (0.36 + index * 0.18 + Math.random() * 0.08),
						),
						dir: index === 0 ? 0 : 2,
					}));
				}

				const x = Math.floor(cols * (width > 900 ? 0.2 : 0.5));
				return [
					{
						rule: config.rules[0],
						x,
						y: baseY(),
						dir: Math.floor(Math.random() * 4),
					},
				];
			};

			const build = () => {
				const width = window.innerWidth;
				const height = window.innerHeight;
				const dpr = Math.min(window.devicePixelRatio || 1, 2);

				cell = Math.max(7, Math.round(Math.min(width, height) / 110));
				cols = Math.ceil(width / cell) + 1;
				rows = Math.ceil(height / cell) + 1;

				canvas.width = Math.ceil(width * dpr);
				canvas.height = Math.ceil(height * dpr);
				ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

				grid = new Uint8Array(cols * rows);
				ants = makeAnts();
				ensureCursors(ants.length);
				steps = 0;
				shown = -1;

				readTheme();

				const warm = Math.min(
					config.prewarm,
					Math.floor(cols * rows * 2.2),
				);
				for (let i = 0; i < warm; i++) advance(false);

				paintAll();
				updateReadout();
			};

			const tick = (now: number) => {
				if (!running || resetting) return;

				if (!last) last = now;
				const delta = Math.min(now - last, 120);
				last = now;
				carry += (delta / 1000) * SPEED;

				const count = Math.min(Math.floor(carry), 60);
				carry -= count;

				for (let i = 0; i < count; i++) {
					advance(true);
					if (steps >= CYCLE) {
						restart(true);
						return;
					}
				}

				ctx.globalAlpha = 1;
				updateReadout();
				raf = requestAnimationFrame(tick);
			};

			const start = () => {
				if (running || resetting) return;
				running = true;
				last = 0;
				setToggle();
				raf = requestAnimationFrame(tick);
			};

			const stop = () => {
				running = false;
				cancelAnimationFrame(raf);
				setToggle();
			};

			const restart = (fade = false) => {
				if (fade && !reduced.matches) {
					resetting = true;
					running = false;
					cancelAnimationFrame(raf);
					setToggle();
					setCursorOpacity("0");
					canvas.classList.add("is-fading");
					window.setTimeout(() => {
						build();
						setCursorOpacity("");
						canvas.classList.remove("is-fading");
						resetting = false;
						if (!userPaused) start();
					}, 620);
					return;
				}

				running = false;
				cancelAnimationFrame(raf);
				build();
				if (!userPaused) start();
			};

			toggle.addEventListener("click", () => {
				if (running) {
					userPaused = true;
					stop();
				} else {
					userPaused = false;
					start();
				}
			});

			document.addEventListener("visibilitychange", () => {
				if (document.hidden) {
					cancelAnimationFrame(raf);
					running = false;
					setToggle();
				} else if (!userPaused && !reduced.matches) {
					start();
				} else {
					setToggle();
				}
			});

			window.addEventListener("resize", () => {
				window.clearTimeout(resizeTimer);
				resizeTimer = window.setTimeout(() => restart(false), 180);
			});

			new MutationObserver(() => {
				readTheme();
				paintAll();
			}).observe(document.documentElement, {
				attributes: true,
				attributeFilter: ["data-theme"],
			});

			reduced.addEventListener("change", (event) => {
				if (event.matches) {
					userPaused = true;
					stop();
				}
			});

			build();
			userPaused = reduced.matches;
			if (!userPaused) {
				start();
			} else {
				setToggle();
			}
		}
	}
</script>

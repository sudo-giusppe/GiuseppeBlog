---
const width = 720;
const height = 64;
const mid = height / 2;
const samples = 260;

const points: string[] = [];
for (let i = 0; i <= samples; i++) {
	const t = i / samples;
	const x = t * width;
	const signal = Math.sin(t * Math.PI * 5.4 - 0.7) * Math.exp(-1.45 * t);
	const y = mid - signal * 21;
	points.push(`${i === 0 ? "M" : "L"}${x.toFixed(2)},${y.toFixed(2)}`);
}

const d = points.join(" ");
const ticks = Array.from({ length: 9 }, (_, i) => (i * width) / 8);
---

<figure class="plot" aria-hidden="true">
	<svg viewBox={`0 0 ${width} ${height}`} data-plot focusable="false">
		<line
			class="tick"
			x1="0"
			y1={mid}
			x2={width}
			y2={mid}
			opacity="0.55"
		></line>
		{
			ticks.map((x) => (
				<line
					class="tick"
					x1={x}
					y1={height - 6}
					x2={x}
					y2={height}
					opacity="0.55"
				/>
			))
		}
		<path class="trace" d={d}></path>
		<circle
			class="trace-dot"
			cx={width}
			cy={mid - Math.sin(Math.PI * 5.4 - 0.7) * Math.exp(-1.45) * 21}
			r="2.2"
			opacity="0"
		></circle>
	</svg>
</figure>

<script>
	import { animate } from "motion";

	const plot = document.querySelector("[data-plot]");
	if (plot) {
		const trace = plot.querySelector<SVGPathElement>(".trace");
		const dot = plot.querySelector<SVGCircleElement>(".trace-dot");
		const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

		if (trace && dot) {
			if (reduce) {
				dot.style.opacity = "1";
			} else {
				const length = trace.getTotalLength();
				trace.style.strokeDasharray = `${length}`;
				trace.style.strokeDashoffset = `${length}`;

				animate(
					trace,
					{ strokeDashoffset: [length, 0] },
					{
						duration: 1.5,
						delay: 0.3,
						ease: [0.22, 1, 0.36, 1],
					},
				);
				animate(
					dot,
					{ opacity: [0, 1] },
					{ duration: 0.35, delay: 1.65, ease: "easeOut" },
				);
			}
		}
	}
</script>
